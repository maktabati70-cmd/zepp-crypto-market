      "platforms": [
        { "name": "t-rex-2", "deviceSource": 418 },
        { "name": "t-rex-2-w", "deviceSource": 419 }
      ],
      "designWidth": 454
    }
  },
  "i18n": { "en-US": { "appName": "Crypto Market" } },
