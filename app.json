{
  "configVersion": "v2",
  "app": {
    "appId": 1000008,
    "appName": "Crypto Market",
    "appType": "app",
    "version": { "code": 1, "name": "1.0.0" },
    "icon": "icon.png",
    "vender": "KIM",
    "description": "Crypto prices, market overview and top movers on your wrist"
  },
  "permissions": ["data:os.device.info", "device:os.local_storage"],
